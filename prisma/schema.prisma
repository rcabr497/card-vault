generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth.js (Credentials provider, database sessions) ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

enum BinderType {
  pokemon
  mtg
  sports
}

enum Sport {
  baseball
  basketball
  football
  hockey
  soccer
  mma
}

enum CardCategory {
  pokemon
  mtg
  sports
  other
}

enum CardCondition {
  NM
  LP
  EX
  MINT
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String
  plan         String    @default("free")
  // Public trading identity (lowercase, unique). Null until the user picks one.
  handle       String?   @unique
  createdAt    DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  binders        Binder[]
  cards          Card[]
  decks          Deck[]
  tradesProposed Trade[]   @relation("TradeProposer")
  tradesReceived Trade[]   @relation("TradeRecipient")
}

model Binder {
  id                String     @id @default(cuid())
  userId            String
  name              String
  type              BinderType
  sport             Sport?
  isShared          Boolean    @default(false)
  shareSlug         String?    @unique
  originalOwnerName String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  binderCards BinderCard[]

  @@index([userId])
}

model Card {
  id              String        @id @default(cuid())
  userId          String
  category        CardCategory
  name            String
  setName         String?
  cardNumber      String?
  year            Int?
  team            String?
  rarity          String?
  condition       CardCondition @default(NM)
  gradingCompany  String?
  grade           String?
  quantity        Int           @default(1)
  purchasePrice   Decimal?      @db.Decimal(10, 2)
  currentValue    Decimal?      @db.Decimal(10, 2)
  imageUrl        String?
  thumbnailUrl    String?
  cardSightId     String?
  notes           String?
  metadataJson    String?
  createdAt       DateTime      @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckCards   DeckCard[]
  binderCards BinderCard[]
  tradeItems  TradeItem[]

  @@index([userId])
  @@index([name])
}

model BinderCard {
  binderId String
  cardId   String
  addedAt  DateTime @default(now())

  binder Binder @relation(fields: [binderId], references: [id], onDelete: Cascade)
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([binderId, cardId])
  @@index([cardId])
}

model Deck {
  id                String   @id @default(cuid())
  userId            String
  name              String
  featuredImageUrl  String?
  format            String?
  notes             String?
  isShared          Boolean  @default(false)
  shareSlug         String?  @unique
  originalOwnerName String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deckCards DeckCard[]

  @@index([userId])
}

model DeckCard {
  deckId   String
  cardId   String
  quantity Int    @default(1)

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([deckId, cardId])
}

enum TradeStatus {
  proposed
  accepted
  declined
  cancelled
  completed
}

// A trade between two users. Either side may give nothing (a gift), but at
// least one card moves. Records only change hands when both people confirm.
model Trade {
  id                   String      @id @default(cuid())
  proposerId           String
  recipientId          String
  status               TradeStatus @default(proposed)
  // While "proposed": the user who has to respond. Null once accepted/closed.
  awaitingUserId       String?
  revision             Int         @default(1)
  note                 String?
  proposerConfirmedAt  DateTime?
  recipientConfirmedAt DateTime?
  expiresAt            DateTime
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  completedAt          DateTime?

  proposer  User        @relation("TradeProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  recipient User        @relation("TradeRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  items     TradeItem[]

  @@index([proposerId])
  @@index([recipientId])
  @@index([status])
}

// One card (and how many copies) a user gives in a trade. The descriptive
// fields are a snapshot so history still reads correctly after the card
// moves to the other user or is deleted.
model TradeItem {
  id             String        @id @default(cuid())
  tradeId        String
  ownerId        String
  cardId         String?
  quantity       Int
  name           String
  category       CardCategory
  setName        String?
  cardNumber     String?
  year           Int?
  condition      CardCondition
  gradingCompany String?
  grade          String?
  imageUrl       String?
  thumbnailUrl   String?
  currentValue   Decimal?      @db.Decimal(10, 2)

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  card  Card? @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([tradeId])
  @@index([cardId])
  @@index([ownerId])
}
